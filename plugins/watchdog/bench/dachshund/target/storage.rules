rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }
    match /uploads/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
